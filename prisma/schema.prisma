  label          String
  required       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, sortOrder])
}

model RegistrationConfig {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consentFormTitle       String?
  consentFormDescription String?
  consentFormSampleUrl   String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model Position {
  id                  String                         @id @default(cuid())
  name                String // e.g. "Camp Director", "Registration Head"
  campId              String
  camp                Camp                           @relation(fields: [campId], references: [id], onDelete: Cascade)
  departmentId        String? // Nullable for top-level admin roles outside departments
  department          Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parentPositionId    String?
  parentPosition      Position?                      @relation("PositionHierarchy", fields: [parentPositionId], references: [id], onDelete: SetNull)
  childPositions      Position[]                     @relation("PositionHierarchy")
  displayOrder        Int                            @default(0)
  status              String                         @default("ACTIVE") // ACTIVE | ARCHIVED
  roleKind            DepartmentRoleKind             @default(MEMBER)
  purpose             String?
  responsibilities    String[]                       @default([])
  authority           String[]                       @default([])
  successMeasures     String[]                       @default([])
  assignments         PositionAssignment[]
  checklistItems      DepartmentChecklistItem[]
  checklistExecutions DepartmentChecklistExecution[]
  // Additive: the "Camp Head" leaderboard-admin grant (src/server/api/trpc/
  // scoping.ts's assertCanManageCamp) — whoever currently holds a Position
  // with this flag set, for this camp, gets leaderboard-admin rights
  // without needing an ADMIN/OWNER/SUPER_ADMIN role. Defaults false, so
  // every existing Position row is unaffected.
  grantsManageCamp    Boolean                        @default(false)
  // Narrower than grantsManageCamp: intended for Tribe Heads and Assistant
  // Tribe Heads who may award campers in their assigned tribe without gaining
  // leaderboard settings, structure, or other camp-admin powers.
  grantsAwardPoints   Boolean                        @default(false)
  leadershipRole      CampLeadershipRole?
  deletedAt           DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  @@index([campId])
  @@index([campId, leadershipRole])
  @@index([departmentId])
  @@index([parentPositionId])
  @@index([deletedAt])
}

model PositionAssignment {
  id          String             @id @default(cuid())
  positionId  String
  position    Position           @relation(fields: [positionId], references: [id], onDelete: Cascade)
