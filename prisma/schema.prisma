  fileSize     Int
  uploadedById String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

model DepartmentActivityLog {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  action       String // STAFF_ASSIGNED, STAFF_REMOVED, HEAD_CHANGED, DEPT_RENAMED, DEPT_ARCHIVED
  actorId      String
  details      Json?
  createdAt    DateTime   @default(now())

  @@index([departmentId])
}

// ─── Communication Center ──────────────────────────────────────────────────

model EmailEventConfig {
  id                  String         @id @default(cuid())
  organizationId      String
  event               String // REGISTRATION_APPROVED | REGISTRATION_REJECTED | REGISTRATION_SUBMITTED | CORRECTION_REQUESTED | REGISTRATION_WAITLISTED | STAFF_APPROVED | STAFF_REJECTED | OTP_EMAIL | WELCOME_EMAIL
  enabled             Boolean        @default(true)
  templateId          String?
  template            EmailTemplate? @relation(fields: [templateId], references: [id])
  channels            Json           @default("[\"EMAIL\", \"IN_APP\"]")
  recipients          Json           @default("[\"PARENT\"]")
  senderMode          String         @default("ORG_SLUG")
  customFromLocalPart String?
  replyTo             String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([organizationId, event])
  @@index([organizationId])
}

model EmailTemplate {
  id             String             @id @default(cuid())
  organizationId String
  name           String // "Registration Approved", "Welcome", etc.
  description    String?
  subject        String // "You're approved for {{camp_name}}!"
  previewText    String?
  content        Json // TipTap JSON
  isDefault      Boolean            @default(false)
  active         Boolean            @default(true)
  includeIdCard  Boolean            @default(false) // opts this template into {{camp_id_card}} substitution
  eventConfigs   EmailEventConfig[] // Events using this template
  campaigns      EmailCampaign[]
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, name])
  @@index([deletedAt])
}

model PlatformBranding {
  id              String   @id @default("default")
  platformLogoUrl String?
  faviconUrl      String?
  pwaIcon192Url   String?
  pwaIcon512Url   String?
  appleIconUrl    String?
  emailLogoUrl    String?
  primaryColor    String   @default("#0D9488")
  accentColor     String   @default("#E67E22")
  headerImageUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrganizationBranding {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logoUrl            String?
  masterLogoUrl      String? // Primary Brand Logo (Default for all tenant views)
  emailLogoUrl       String? // Optional Email Header override
  idCardLogoUrl      String? // Optional ID Card PDF override
  primaryColor       String       @default("#E67E22")
  accentColor        String       @default("#E67E22")
  buttonColor        String       @default("#E67E22")
  headerImageUrl     String?
  senderName         String? // Display name for email sender (e.g. "Grace Community Church")
  footerText         String?
  supportEmail       String?
  supportPhone       String?
  websiteUrl         String?
  facebookUrl        String?
  instagramUrl       String?
  address            String?
  // Camp Invitation certificate email fields (Phase 2 email redesign)
  tagline            String? // shown under the org name in the certificate header
  supportTitle       String? // e.g. "Need Help?" — falls back to a hardcoded default if unset
  supportDescription String? // e.g. "We're here to help."
  footerCopyright    String? // e.g. "© 2026 The Covenant Nation. All rights reserved."
  phone              String? // general org phone, distinct from supportPhone
  xUrl               String?
  linkedinUrl        String?
  nextSteps          Json? // [{ icon, title, description }] — admin-editable "What's Next" list
  // Camp ID Card feature — org-level master switch (per-template opt-in lives on EmailTemplate.includeIdCard)
  idCardEnabled      Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Broadcast {
  id                  String               @id @default(cuid())
  organizationId      String
  title               String
  subject             String
  body                Json // TipTap JSON
  audience            String // PARENTS | TEACHERS | VOLUNTEERS | ALL
  campId              String?
  campusId            String?
  status              String               @default("DRAFT") // DRAFT | SENDING | COMPLETED | FAILED
  senderMode          String               @default("ORG_SLUG")
  customFromLocalPart String?
  replyTo             String?
  createdById         String
  sentAt              DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  recipients          BroadcastRecipient[]

  @@index([organizationId, status])
}

model BroadcastRecipient {
  id           String    @id @default(cuid())
  broadcastId  String
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  recipientId  String // userId
  email        String
  status       String    @default("QUEUED") // QUEUED | SENT | FAILED
  sideEffectId String?
  queuedAt     DateTime  @default(now())
  sentAt       DateTime?
  failedAt     DateTime?
  error        String?
  readAt       DateTime?
  pinned       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([broadcastId, status])
  @@index([recipientId, readAt])
  @@index([recipientId, pinned])
}

// ─── Campaigns (replaces Broadcast) ──────────────────────────────────────────

model EmailCampaign {
  id                  String           @id @default(cuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  subject             String
  previewText         String?
  templateId          String?
  template            EmailTemplate?   @relation(fields: [templateId], references: [id])
  body                Json // TipTap JSON
  status              String           @default("DRAFT") // DRAFT | SCHEDULED | QUEUED | SENDING | COMPLETED | PAUSED | CANCELLED | FAILED
  scheduledFor        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  recipientCount      Int              @default(0)
  audienceFilter      Json? // SavedAudience filter definition (inline or reference)
  savedAudienceId     String?
  savedAudience       SavedAudience?   @relation(fields: [savedAudienceId], references: [id])
  senderMode          String           @default("ORG_SLUG")
  customFromLocalPart String?
  replyTo             String?
  attachments         Json? // [{ url, fileName, fileType, fileSize }]
  createdById         String
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  recipients          EmailRecipient[]
  sideEffects         SideEffect[]
  // Personalized certificate-style campaigns (Phase 2 email redesign). When
  // set, the sender resolves one recipient per APPROVED registration in
  // personalizeCampId (not resolveAudience()'s flat user list) and renders
  // via renderEmailWithEvent's event-assembler pipeline instead of the
  // legacy renderEmail() TipTap-only path. Unset = today's unchanged
  // broadcast behavior, fully backward compatible.
  personalizeEvent    String?
  personalizeCampId   String?

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
}

model EmailRecipient {
  id                String         @id @default(cuid())
  campaignId        String?
  campaign          EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  organizationId    String?
  userId            String
  registrationId    String?
  email             String
  recipientType     String // PARENT | TEACHER | VOLUNTEER | CAMPUS_REP | ADMIN
  deliveryStatus    String         @default("QUEUED") // QUEUED | SENT | DELIVERED | OPENED | CLICKED | BOUNCED | FAILED | CANCELLED
  deliverySource    String? // REGISTRATION_APPROVED | CAMPAIGN | OTP | WELCOME | STAFF_APPROVED | ...
  subject           String? // email subject line
  queuedAt          DateTime       @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  failedReason      String?
  retryCount        Int            @default(0)
  providerMessageId String?
  sideEffectId      String?
  readAt            DateTime? // inbox read tracking
  pinned            Boolean        @default(false) // inbox pin
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([campaignId, deliveryStatus])
  @@index([organizationId, createdAt])
  @@index([userId, readAt])
  @@index([userId, pinned])
  @@index([email])
  @@index([registrationId])
  @@index([deliverySource])
}

model SavedAudience {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  filterDefinition Json // { recipientType, filters: { registrationStatus?, campId?, campusId?, ... } }
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  campaigns        EmailCampaign[]

  @@index([organizationId])
}

model EmailAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // CAMPAIGN_SENT | CAMPAIGN_CANCELLED | RETRY_TRIGGERED | QUEUE_PAUSED | QUEUE_RESUMED | CAMPAIGN_DELETED
  targetType     String? // CAMPAIGN | QUEUE | RECIPIENT | TEMPLATE | EVENT_CONFIG
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
}

model ScanEvent {
  id             String       @id @default(cuid())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String
  campId         String?
  camp           Camp?        @relation(fields: [campId], references: [id], onDelete: Cascade)
  station        String // e.g. "Lekki Pickup Point", "Camp Arrival", "Breakfast", "Checkout", "Identity Lookup"
  timestamp      DateTime     @default(now())
  volunteer      User         @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  volunteerId    String
  device         String?
  location       String?
  result         String // "SUCCESS" | "DUPLICATE" | "ERROR"
  metadata       Json? // Stores collector name, relationship, offline timestamp details, etc.

  @@index([registrationId])
  @@index([campId])
  @@index([timestamp])
}

// ─── Signup Link Click Tracking ───────────────────────────────────────────────

model SignupLinkClick {
  id           String     @id @default(cuid())
  signupLink   SignupLink @relation(fields: [signupLinkId], references: [id], onDelete: Cascade)
  signupLinkId String
  userId       String? // null = anonymous; populated after the visitor logs in/registers
  ipAddress    String?
  userAgent    String?
  clickedAt    DateTime   @default(now())

  @@index([signupLinkId])
  @@index([clickedAt])
}

model StaffSignupLinkClick {
  id                String          @id @default(cuid())
  staffSignupLink   StaffSignupLink @relation(fields: [staffSignupLinkId], references: [id], onDelete: Cascade)
  staffSignupLinkId String
  userId            String?
  ipAddress         String?
  userAgent         String?
  clickedAt         DateTime        @default(now())

  @@index([staffSignupLinkId])
  @@index([clickedAt])
}

// ─── Web Push Subscriptions & Audit Logs ──────────────────────────────────────

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  endpoint       String   @unique
  p256dh         String
  auth           String
  deviceId       String?
  station        String?
  browser        String?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model WebPushLog {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  message        String
  priority       String   @default("INFO") // INFO | SUCCESS | WARNING | CRITICAL
  targetAudience String // ALL | CAMPUS | STATION | ROLE
  targetId       String? // campusId | stationName | roleName
  actionUrl      String?
  sentById       String?
  successCount   Int      @default(0)
  failCount      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ─── Camp Program Schedule & Live Time Management ─────────────────────────────

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScheduleEventKind {
  TIMED
  MILESTONE
}

model CampSchedule {
  id              String              @id @default(cuid())
  camp            Camp                @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId          String
  revision        Int                 @default(1)
  status          ScheduleStatus      @default(DRAFT)
  timezone        String              @default("Africa/Lagos")
  reminderMinutes Int[]               @default([5, 3, 2])
  version         Int                 @default(1)
  sourceMetadata  Json?
  publishMetadata Json?
  events          CampScheduleEvent[]
  changes         CampScheduleChange[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([campId, status])
  @@unique([campId, revision])
}

model CampScheduleEvent {
  id             String               @id @default(cuid())
  schedule       CampSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId     String
  dayNumber      Int
  eventDate      DateTime             @db.Date
  kind           ScheduleEventKind    @default(TIMED)
  title          String
  facilitator    String?
  location       String?
  notes          String?
  plannedStart   DateTime
  plannedEnd     DateTime?
  effectiveStart DateTime
  effectiveEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  sortOrder      Int                  @default(0)
  cancelled      Boolean              @default(false)
  changes        CampScheduleChange[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([scheduleId, dayNumber])
  @@index([scheduleId, sortOrder])
}

model CampScheduleChange {
  id          String             @id @default(cuid())
  schedule    CampSchedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId  String
  event       CampScheduleEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId     String?
  actorId     String
  changeType  String
  minuteDelta Int?
  beforeState Json?
  afterState  Json?
  reason      String?
  createdAt   DateTime           @default(now())

  @@index([scheduleId, createdAt])
}
