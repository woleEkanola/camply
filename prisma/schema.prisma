  staff       StaffProfile       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate   DateTime           @default(now())
  endDate     DateTime?
  isCurrent   Boolean            @default(true)
  accessMode  CommandAccessMode?
  permissions String[]           @default([])
  reason      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([positionId])
  @@index([staffId])
  @@index([isCurrent])
}

model DepartmentChecklistItem {
  id              String                         @id @default(cuid())
  department      Department                     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId    String
  title           String
  description     String?
  routine         ChecklistRoutine               @default(ONE_TIME)
  sourceGroup     String?
  contextLabel    String?
  assignmentType  ChecklistAssignmentType        @default(EVERYONE)
  position        Position?                      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  positionId      String?
  assignedStaff   StaffProfile?                  @relation("ChecklistItemAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  dueTime         String?
  specificDate    DateTime?                      @db.Date
  required        Boolean                        @default(true)
  active          Boolean                        @default(true)
  sortOrder       Int                            @default(0)
  version         Int                            @default(1)
  createdById     String?
  updatedById     String?
  executions      DepartmentChecklistExecution[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([departmentId, active, routine])
  @@index([positionId])
  @@index([assignedStaffId])
