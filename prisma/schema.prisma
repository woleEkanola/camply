  campId          String
  date            DateTime   @db.Date
  completedWork   String
  outstandingWork String?
  issues          String?
  escalations     String?
  notes           String?
  submittedById   String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([departmentId, date, submittedById])
  @@index([campId, date])
  @@index([departmentId, date])
}

model CampCommandPolicy {
  id                          String            @id @default(cuid())
  camp                        Camp              @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId                      String            @unique
  commandantMode              CommandAccessMode @default(FULL)
  commandantPermissions       String[]          @default([])
  assistantDefaultMode        CommandAccessMode @default(CUSTOM)
  assistantDefaultPermissions String[]          @default([])
  updatedById                 String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
}

model DepartmentAnnouncement {
