// This is your Prisma schema file, simplified for the new requirements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  CAMPUS_REPRESENTATIVE
  PARENT
  TEACHER
  VOLUNTEER
}

enum CampLeadershipRole {
  COMMANDANT
  ASSISTANT_COMMANDANT
}

enum CommandAccessMode {
  INHERIT
  FULL
  CUSTOM
}

enum DepartmentRoleKind {
  HEAD
  ASSISTANT_HEAD
  LEAD
  MEMBER
}

enum ChecklistRoutine {
  BEFORE_CAMP
  DAILY
  SPECIFIC_DAY
  BEFORE_PROGRAMME
  DURING_PROGRAMME
  AFTER_PROGRAMME
  BEFORE_MEAL
  DURING_MEAL
  AFTER_MEAL
  END_OF_DAY
  ARRIVAL
  AFTER_CHECKOUT
  AFTER_CAMP
  ONE_TIME
}

enum ChecklistAssignmentType {
  EVERYONE
  ROLE
  PERSON
}

enum ChecklistExecutionStatus {
  PENDING
  COMPLETED
  SKIPPED
  OVERDUE
}

// LOGIN covers both the parent self-signup/login OTP flow and the staff
// signup OTP flow — both are "authenticate with a mailed code" and neither
// can escalate by sharing a bucket, since the OTP model was already a single
// row per email (no purpose distinction at all) before this enum existed.
// PASSWORD_RESET is kept strictly isolated: a code issued to reset a
// password must never double as a login code, and vice versa.
enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  STAFF_SIGNUP
}

enum PermissionType {
  CREATE_CAMPUS
  READ_CAMPUS
  UPDATE_CAMPUS
  DELETE_CAMPUS
  MANAGE_ADMINS
  MANAGE_CAMPUS_REPS
  VIEW_ANALYTICS
}

enum ProfileFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  CHECKBOX
  SELECT
  MULTI_SELECT
  RADIO
  FILE
  PHONE
}

enum FormFieldAudience {
  CAMPER
  TEACHER
  VOLUNTEER
}

enum FormFieldSource {
  SYSTEM
  CUSTOM
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  PENDING
  REQUIRES_ACTION
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
  CHECKED_IN
  COMPLETED
  ARCHIVED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model User {
  id                       String             @id @default(cuid())
  email                    String             @unique
  password                 String
  passwordSet              Boolean            @default(false)
  emailVerified            DateTime?
  emailVerifyToken         String?
  photoUrl                 String?
  role                     UserRole
  firstName                String?
  lastName                 String?
  phone                    String?
  active                   Boolean            @default(true)
  organization             Organization?      @relation(fields: [organizationId], references: [id])
  organizationId           String?
  homeCampus               Campus?            @relation("UserCampus", fields: [homeCampusId], references: [id])
  homeCampusId             String?
  managedCampuses          Campus[]           @relation("CampusReps")
  permissions              Permission[]
  campers                  Camper[] // User can have multiple camper profiles
  staffProfiles            StaffProfile[]
  reportsFromStaff         StaffProfile[]     @relation("StaffReportsToUser")
  pushSubscriptions        PushSubscription[]
  scanEvents               ScanEvent[]
  staffScanEventsPerformed StaffScanEvent[]   @relation("StaffScanScannedBy")
  deletedAt                DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([deletedAt])
}

model Organization {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  slug                     String?
  users                    User[]
  campuses                 Campus[]
  formFields               FormField[] // Organization defines registration form fields (camper/teacher/volunteer)
  campers                  Camper[] // Organization has many camper profiles
  camps                    Camp[] // Organization has many camps
  activeCampId             String? // Reference to the active camp
  activeCamp               Camp?                     @relation("ActiveCamp", fields: [activeCampId], references: [id])
  settings                 Json? // Holds admin settings such as age range, cutoff date, etc.
  registrationDeclarations RegistrationDeclaration[]
  registrationConfig       RegistrationConfig?
  branding                 OrganizationBranding?
  emailCampaigns           EmailCampaign[]
  savedAudiences           SavedAudience[]
  approvalWorkflow         String                    @default("SINGLE_STEP") // SINGLE_STEP | TWO_STEP
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

// Campus: permanent church branch/organization structure. Identity only -
// never holds camp-operational fields like capacity/quota. See Venue for
// the temporary, per-Camp physical site those belong to.
model Campus {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  address         String
  city            String
  state           String?
  zipCode         String?
  country         String
  pastor          String?
  phone           String?
  email           String?
  suspended       Boolean   @default(false) // halts submit/endorse/approve for this campus without touching its signup link — see src/server/registration/validation.ts and engine.ts
  suspendedAt     DateTime?
  suspendedById   String?
  suspendedReason String?
  campusCode      String? // short code embedded in registration numbers
  displayOrder    Int       @default(0) // order in dropdowns/lists

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId      String
  reps                User[]               @relation("CampusReps")
  users               User[]               @relation("UserCampus")
  campers             Camper[]
  registrations       Registration[]
  signupLinks         SignupLink[]
  teacherCampusQuotas TeacherCampusQuota[]

  registrationCounters RegistrationCounter[]
  preferredByStaff     StaffProfile[]        @relation("PreferredStaffCampus")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Uniqueness on (organizationId, name) is enforced by a partial unique index
  // (WHERE "deletedAt" IS NULL) — Campus_organizationId_name_key, added by
  // prisma/migrations/20260728000000_partial_unique_indexes, not by Prisma's
  // schema-level @@unique — see the soft-delete migration notes.
  @@index([organizationId, name])
  @@index([deletedAt])
}

// Venue: physical camp site, scoped to exactly one Camp (not reused across
// camps - a new Venue row is created each time, even for the same physical
// facility). Holds all camp-operational/capacity fields that used to live
// on Location.
model Venue {
  id           String  @id @default(cuid())
  name         String
  address      String?
  capacity     Int?
  contactPhone String?
  contactEmail String?
  gpsLat       Float?
  gpsLng       Float?
  mapsUrl      String?
  notes        String?

  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String

  code         String?
  quota        Int     @default(0)
  signupOpen   Boolean @default(true)
  visible      Boolean @default(true)
  fullBehavior String  @default("CLOSE") // CLOSE | PENDING_OK | REDIRECT

  registrations      Registration[]
  hostels            Hostel[]
  assignedStaff      StaffProfile[]      @relation("AssignedStaffVenue")
  attendanceSessions AttendanceSession[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Partial unique index (WHERE "deletedAt" IS NULL) — Venue_campId_name_key,
  // added by prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([campId, name])
  @@index([deletedAt])
}

model Permission {
  id        String         @id @default(cuid())
  type      PermissionType
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, type])
}

model FormField {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audience       FormFieldAudience
  source         FormFieldSource     @default(CUSTOM)
  systemKey      String? // set only when source = SYSTEM; names the bound profile column
  name           String // stable key: systemKey for SYSTEM, admin-chosen slug for CUSTOM
  label          String
  type           ProfileFieldType
  required       Boolean             @default(false)
  visible        Boolean             @default(true)
  options        String? // JSON string for select/multi-select/radio options
  helpText       String?
  placeholder    String?
  defaultValue   String?
  groupLabel     String? // visual section header in the wizard
  sortOrder      Int                 @default(0)
  validation     Json?
  profileValues  ProfileFieldValue[]
  staffValues    StaffFieldValue[]
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Partial unique index (WHERE "deletedAt" IS NULL) —
  // FormField_organizationId_audience_name_key, added by
  // prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([organizationId, audience, name])
  @@index([organizationId, audience, sortOrder])
  @@index([deletedAt])
}

model Camper {
  id            String    @id @default(cuid())
  name          String
  firstName     String?
  middleName    String?
  lastName      String?
  preferredName String?
  dateOfBirth   DateTime? // Date of birth field
  gender        String? // Gender field
  photoUrl      String?

  // Medical / Emergency (PRD Part 3 §8)
  allergies             String?
  medicalConditions     String?
  medications           String?
  dietaryRestrictions   String?
  emergencyContactName  String?
  emergencyContactPhone String?
  relationship          String?
  // Structured medical profile for allocation engine v2
  medicalProfile        Json? // { conditions[], mobilityNeeds, specialAccommodations, dietaryRestrictions }

  // Contact Details
  parentPhone       String?
  teenPhone         String?
  homeAddressStreet String?
  homeAddressCity   String?
  homeAddressState  String?
  homeAddressZip    String?

  // Education / Church
  school       String?
  currentClass String?
  church       String?
  pastor       String?

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  // Denormalized "last known" home campus - non-authoritative convenience field.
  // Prefer Registration.campusId for historical accuracy; this is kept in sync
  // on every registration-affecting mutation (see registration engine) because
  // existing UI (camper list filters, home-campus display) reads it directly.
  homeCampus     Campus?             @relation(fields: [homeCampusId], references: [id])
  homeCampusId   String?
  fieldValues    ProfileFieldValue[]
  registrations  Registration[] // Profile can have many registrations
  documents      Document[]
  active         Boolean             @default(true)
  dobApproved    Boolean             @default(false)
  birthCert      String? // URL to uploaded birth certificate
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([deletedAt])
}

model ProfileFieldValue {
  id        String    @id @default(cuid())
  value     String // Stored as string, converted based on field type
  field     FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId   String
  camper    Camper    @relation(fields: [camperId], references: [id], onDelete: Cascade)
  camperId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([fieldId, camperId])
}

// Camp: a temporary camp event (e.g. "Teen Camp 2025"). Year is one
// attribute of the Camp, not the entity itself - multiple Camps can occur
// within the same calendar year.
model Camp {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String
  year                          Int
  startDate                     DateTime
  endDate                       DateTime
  active                        Boolean                        @default(false)
  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId                String
  venues                        Venue[]
  registrations                 Registration[]
  activeForOrgs                 Organization[]                 @relation("ActiveCamp")
  signupLinks                   SignupLink[]
  documentRequirements          DocumentRequirement[]
  registrationCounters          RegistrationCounter[]
  staffSignupLinks              StaffSignupLink[]
  staffProfiles                 StaffProfile[]
  attendanceSessions            AttendanceSession[]
  incidentReports               IncidentReport[]
  medicalVisits                 MedicalVisit[]
  mealDistributions             MealDistribution[]
  staffMealDistributions        StaffMealDistribution[]
  scanEvents                    ScanEvent[]
  staffScanEvents               StaffScanEvent[]
  departments                   Department[]
  positions                     Position[]
  departmentChecklistExecutions DepartmentChecklistExecution[]
  departmentReports             DepartmentReport[]
  commandPolicy                 CampCommandPolicy?
  teacherCampusQuotas           TeacherCampusQuota[]

  // Tribe Allocation (PRD Part 4A)
  tribeAllocationEnabled Boolean              @default(false)
  tribeAllocationMode    String               @default("MANUAL") // MANUAL | AUTOMATIC | HYBRID
  tribeAllocationRules   Json? // [{ criterion, enabled }] — legacy flat format; mapped to v2 internally
  targetTribeSize        Int? // Optional override; otherwise computed from approved_registrations / active_tribes
  tribeAllocationPresets Json? // [{ name, description, rules }]
  tribes                 Tribe[]
  tribeAllocationLogs    TribeAllocationLog[]

  // Bed Allocation (mirrors Tribe Allocation above) — gender-match to Hostel.gender
  // is always a hard filter in the engine, not a toggleable rule here.
  bedAllocationEnabled Boolean @default(false)
  bedAllocationRules   Json? // ordered array: [{ criterion: "AGE_GROUP"|"GROUP_TOGETHER"|"CAMPUS_TOGETHER"|"POPULATION_BALANCE", enabled: true }]

  // Camp Configuration (PRD Part 2)
  theme                String?
  description          String?
  bannerUrl            String?
  logoUrl              String?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  arrivalDate          DateTime?
  departureDate        DateTime?
  minAge               Int?
  maxAge               Int?
  ageCutoffDate        DateTime?
  maxRegistrations     Int? // null = unlimited
  capacityBehavior     String    @default("CLOSE") // CLOSE | WAITLIST | PENDING_OK
  approvalMode         String    @default("MANUAL") // MANUAL | AUTO
  allowResubmission    Boolean   @default(true)
  status               String    @default("DRAFT") // DRAFT | OPEN | CLOSED | ARCHIVED
  orgCode              String?
  remindersHtml        String?

  // Additive: leaderboard back-relations. Every other leaderboard model's
  // subject FK (tribeId/registrationId/staffProfileId/categoryId/ruleId/
  // scoredSessionId) is a deliberate plain scalar with no Prisma relation, to
  // avoid touching Tribe/Registration/StaffProfile for this — only Camp
  // (the tenant boundary) gets real relations here.
  scoreEvents            ScoreEvent[]
  scoreCategories        ScoreCategory[]
  scoreRules             ScoreRule[]
  scoredSessions         ScoredSession[]
  achievementDefinitions AchievementDefinition[]
  leaderboardSettings    LeaderboardSettings?
  schedules              CampSchedule[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Partial unique indexes (WHERE "deletedAt" IS NULL) —
  // Camp_organizationId_name_key and Camp_organizationId_slug_key, added by
  // prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([organizationId, name])
  @@index([organizationId, slug])
  @@index([deletedAt])
}

model SignupLink {
  id                String            @id @default(cuid())
  token             String            @unique // The unique token for the URL
  campus            Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  campusId          String
  camp              Camp              @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId            String
  active            Boolean           @default(true)
  quota             Int               @default(0) // 0 = unlimited
  quotaFullBehavior String            @default("CLOSE") // CLOSE | WAITLIST
  clicks            SignupLinkClick[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([campusId, campId])
}

// Teacher recruitment quota per campus, per camp. Mirrors the philosophy of
// SignupLink.quota but is scoped to teacher recruitment via StaffSignupLink.
model TeacherCampusQuota {
  id                String @id @default(cuid())
  campId            String
  camp              Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campusId          String
  campus            Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  quota             Int    @default(0) // 0 = unlimited
  quotaFullBehavior String @default("CLOSE") // CLOSE | WAITLIST

  @@unique([campId, campusId])
  @@index([campId])
}

// Composite PK (email, purpose) — added by
// prisma/migrations/20260729000100_otp_purpose (enum in
// 20260729000000_otp_purpose_enum first, split per CLAUDE.md's migration
// rules since the enum is used in the same change). One email can hold up
// to 3 concurrent OTPs (one per purpose) rather than a single row that
// login/staff-signup/password-reset all silently clobber.
model OTP {
  email     String
  purpose   OtpPurpose @default(LOGIN)
  code      String
  expiresAt DateTime
  attempts  Int        @default(0)

  @@id([email, purpose])
}

model Registration {
  id              String             @id @default(cuid())
  status          RegistrationStatus @default(DRAFT)
  notes           String?
  camper          Camper             @relation(fields: [camperId], references: [id], onDelete: Cascade)
  camperId        String
  camp            Camp               @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId          String
  campus          Campus             @relation(fields: [campusId], references: [id])
  campusId        String
  // Nullable: assigned later at approval/allocation time, not at signup.
  // Parents pick a Campus at signup; Venue assignment happens once camp
  // operations knows where this camper is physically headed.
  venue           Venue?             @relation(fields: [venueId], references: [id])
  venueId         String?
  venueAssignedAt DateTime?
  parentConsent   String? // URL to uploaded parent consent form
  published       Boolean            @default(false)

  // Registration Engine fields (PRD Part 4)
  registrationNumber            String?   @unique
  qrToken                       String?   @unique
  submittedAt                   DateTime?
  approvedAt                    DateTime?
  rejectionReason               String?
  correctionRequest             String?
  reviewerId                    String?
  checkedInAt                   DateTime?
  checkedInById                 String?
  checkedOutAt                  DateTime?
  checkedOutById                String?
  checkoutCollectorName         String?
  checkoutCollectorRelationship String?
  checkoutDetails               Json?
  internalNotes                 Json? // [{authorId, text, at}]
  communicationLog              Json? // {"ACCEPTANCE":"SENT"|"NOT_SENT","REJECTION":"SENT"|"NOT_SENT","CORRECTION":"SENT"|"NOT_SENT","WAITLIST":"SENT"|"NOT_SENT"}
  fieldChangeLog                Json? // [{field, previousValue, newValue, changedAt, changedById}]
  waitlistPosition              Int?

  // Tribe Allocation (PRD Part 4A)
  tribe                 Tribe?               @relation(fields: [tribeId], references: [id])
  tribeId               String?
  tribeAssignedAt       DateTime?
  tribeAssignmentMethod String? // AUTOMATIC | MANUAL | HYBRID_OVERRIDE
  isTribeLocked         Boolean              @default(false)
  tribeAllocationLogs   TribeAllocationLog[]

  // Tribe Recommendation (v3 Recommendation Engine)
  suggestedTribe               Tribe?    @relation("SuggestedTribe", fields: [suggestedTribeId], references: [id])
  suggestedTribeId             String?
  tribeSuggestedAt             DateTime?
  tribeRecommendationStatus    String    @default("NONE") // NONE | SUGGESTED | ACCEPTED | MANUAL_OVERRIDE | ASSIGNED | LOCKED
  tribeRecommendationReason    Json? // string[] checklist of explanations
  tribeRecommendationScore     Float? // quality score / soft score
  tribeRecommendationBreakdown Json? // Record<Criterion, number>
  tribeOriginalSuggestedId     String? // Tracks original recommendation when overridden

  // Accommodation (Camp Structure module)
  room   Room?   @relation(fields: [roomId], references: [id])
  roomId String?
  bed    Bed?

  documents            Document[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  review               RegistrationReview?
  teacherAssignments   TeacherCamperAssignment[]
  attendanceRecords    AttendanceRecord[]
  incidentReports      IncidentReport[]
  medicalVisits        MedicalVisit[]
  mealDistributions    MealDistribution[]
  scanEvents           ScanEvent[]
  maleLeaderOfTribes   Tribe[]                   @relation("TribeMaleCamperLeader")
  femaleLeaderOfTribes Tribe[]                   @relation("TribeFemaleCamperLeader")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Partial unique index (WHERE "deletedAt" IS NULL) — Registration_camperId_campId_key,
  // added by prisma/migrations/20260728000000_partial_unique_indexes —
  // lets a camper re-register for the same camp after a prior registration was soft-deleted.
  // Note: this makes two simultaneously-live registrations for the same
  // camper+camp impossible going forward, regardless of status. The
  // camperId-based branch of computeDuplicateGroups (src/server/api/routers/registration.ts)
  // can therefore only ever match rows that predate this migration.
  @@index([camperId, campId])
  @@index([campusId, status])
  @@index([venueId, status])
  @@index([campId, status])
  @@index([deletedAt])
  // Additive: every tribe leaderboard read joins Registration through
  // [campId, tribeId] — was missing entirely.
  @@index([campId, tribeId])
}

// ─── Registration Review Workflow ────────────────────────────────────────────

model RegistrationReview {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Verification (two-step only)
  assignedToId       String? // userId of verifier
  verificationStatus String  @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  verifiedById       String? // userId who completed verification
  recommendation     String? // APPROVE | REJECT | CORRECTION
  reviewNotes        String? // verifier's private notes

  // Admin decision (populated on final status change)
  adminDecision String? // APPROVE | REJECT | WAITLIST | CORRECTION | CANCEL | ARCHIVE
  decidedById   String?
  decidedAt     DateTime?

  // Timestamps
  assignedAt  DateTime?
  verifiedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DocumentRequirement {
  id              String     @id @default(cuid())
  camp            Camp       @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId          String
  name            String
  description     String?
  required        Boolean    @default(true)
  acceptedFormats String     @default("jpg,png")
  maxSizeMb       Int        @default(2)
  scope           String     @default("CAMPER") // CAMPER | REGISTRATION
  sortOrder       Int        @default(0)
  documents       Document[]
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([deletedAt])
}

model Document {
  id              String               @id @default(cuid())
  requirement     DocumentRequirement? @relation(fields: [requirementId], references: [id])
  requirementId   String?
  camper          Camper?              @relation(fields: [camperId], references: [id], onDelete: Cascade)
  camperId        String?
  registration    Registration?        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId  String?
  url             String
  fileName        String
  fileType        String
  fileSize        Int
  status          String               @default("UPLOADED") // UPLOADED | APPROVED | REJECTED
  rejectionReason String?
  uploadedById    String
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  documentActions DocumentAction[]

  @@index([deletedAt])
}

model DocumentAction {
  id               String    @id @default(cuid())
  documentId       String
  document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status           String    @default("REQUIRES_ACTION") // REQUIRES_ACTION | RESOLVED
  reason           String
  requestedById    String
  requestedAt      DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionType   String? // PARENT_UPLOAD | REP_UPLOAD | ADMIN_OVERRIDE
  replacementForId String? // links to the document this action replaced, for history
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([documentId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String?
  actorId        String?
  action         String
  previousValue  Json?
  newValue       Json?
  createdAt      DateTime      @default(now())

  // Additive, for the leaderboard's audit trail (award/undo/reset/settings
  // changes) — reuses this table rather than a parallel one. Nullable so
  // every existing writer keeps working unmodified.
  device      String?
  ipAddress   String?
  reason      String?
  subjectType String? // e.g. "TRIBE" | "REGISTRATION" | "STAFF_PROFILE" | "SCORE_CATEGORY" | ...
  subjectId   String?

  @@index([registrationId])
  @@index([organizationId, createdAt])
  @@index([subjectType, subjectId])
}

model Notification {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String?
  channel        String        @default("IN_APP") // IN_APP | EMAIL
  title          String
  body           String
  status         String        @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  // Additive: lets leaderboard notifications ("Judah entered Top 3") deep-link
  // into the app instead of being a dead-end toast.
  link String?

  @@index([userId, readAt])
}

model Tribe {
  id                     String               @id @default(cuid())
  camp                   Camp                 @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId                 String
  name                   String
  code                   String? // Short code e.g. AGP, BER, ZOE
  color                  String? // HEX colour e.g. #E53935
  displayOrder           Int                  @default(0) // Controls sort order throughout the app
  logoUrl                String?
  bannerUrl              String? // Banner image for tribe dashboard / digital pass
  description            String?
  meaning                String? // Short meaning or theme e.g. "Unconditional Love"
  motto                  String? // e.g. "Love Never Fails"
  scripture              String? // e.g. "John 13:34"
  gender                 String? // MALE | FEMALE | MIXED
  ageRange               String? // e.g. "10-12" | "All Ages"
  allocationStrategy     String               @default("MANUAL") // MANUAL | AUTOMATIC | INVITE_ONLY
  maxCapacity            Int?
  isAllocationLocked     Boolean              @default(false)
  status                 String               @default("ACTIVE") // ACTIVE | INACTIVE
  registrations          Registration[]
  suggestedRegistrations Registration[]       @relation("SuggestedTribe")
  allocationLogs         TribeAllocationLog[]
  preferredByStaff       StaffProfile[]       @relation("PreferredTribe")
  assignedStaff          StaffProfile[]       @relation("AssignedStaffTribe")
  maleHead               StaffProfile?        @relation("TribeMaleHead", fields: [maleHeadId], references: [id], onDelete: SetNull)
  maleHeadId             String?
  femaleHead             StaffProfile?        @relation("TribeFemaleHead", fields: [femaleHeadId], references: [id], onDelete: SetNull)
  femaleHeadId           String?
  maleCamperLeader       Registration?        @relation("TribeMaleCamperLeader", fields: [maleCamperLeaderId], references: [id], onDelete: SetNull)
  maleCamperLeaderId     String?
  femaleCamperLeader     Registration?        @relation("TribeFemaleCamperLeader", fields: [femaleCamperLeaderId], references: [id], onDelete: SetNull)
  femaleCamperLeaderId   String?
  attendanceSessions     AttendanceSession[]
  points                 Int                  @default(0)
  pointsLog              TribePointsLog[]
  deletedAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  // Partial unique indexes (WHERE "deletedAt" IS NULL) — Tribe_campId_name_key
  // and Tribe_campId_code_key (the latter also requires "code" IS NOT NULL,
  // since it's optional), added by
  // prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([campId, name])
  @@index([campId, code])
  @@index([maleHeadId])
  @@index([femaleHeadId])
  @@index([maleCamperLeaderId])
  @@index([femaleCamperLeaderId])
  @@index([deletedAt])
}

// ─── Leaderboard & Scoring ───────────────────────────────────────────────────
// New enum ships in its own migration before anything references it
// (Postgres requires enum values committed-before-use — see the
// otp_purpose_enum -> otp_purpose precedent).

enum ScoreSource {
  AUTO
  MANUAL
  SYSTEM
}

// The immutable ledger. Totals are never stored directly on this model —
// LeaderboardStat is a derived, rebuildable cache; this table is the source
// of truth. Every subject FK below (campusId/tribeId/registrationId/
// staffProfileId/categoryId/ruleId/scoredSessionId) is a deliberate plain
// scalar with no Prisma relation — this is a high-write ledger, not a graph
// to traverse via `include`; callers query by the indexed columns below and
// resolve names with a second lookup.
model ScoreEvent {
  id     String @id @default(cuid())
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String

  campusId        String?
  tribeId         String?
  registrationId  String?
  staffProfileId  String?
  categoryId      String
  ruleId          String?
  scoredSessionId String?

  points Int
  reason String?
  notes  String?
  source ScoreSource

  occurredAt DateTime @default(now())
  // @db.Date, not DateTime — the leaderboard's own dayKey.ts computes this
  // from occurredAt + camp timezone. Never write it from a raw JS Date
  // without going through that helper (see scan.ts's dayRange/utcDayRange
  // footgun, which this schema deliberately avoids repeating).
  day        DateTime @db.Date

  createdById String?

  // Double-award guard. Postgres treats NULL as distinct from every other
  // NULL, so this unique index is a no-op for the (majority of) rows that
  // don't set it, and a hard guard for the ones that do.
  idempotencyKey String? @unique

  // Undo is always a new compensating ScoreEvent with negated points,
  // pointing back at the original via this column. The original row is
  // never mutated or deleted.
  reversesEventId String?

  createdAt DateTime @default(now())

  @@index([campId, day])
  @@index([campId, tribeId, day])
  @@index([campId, registrationId, day])
  @@index([campId, staffProfileId, day])
  @@index([campId, createdAt])
  @@index([campId, categoryId, day])
  @@index([reversesEventId])
}

model ScoreCategory {
  id     String  @id @default(cuid())
  camp   Camp?   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String? // null = org-level template, cloned per camp at seed time

  key           String
  name          String
  description   String?
  icon          String?
  color         String?
  defaultPoints Int     @default(0)
  kind          String  @default("BOTH") // AUTO | MANUAL | BOTH
  isPenalty     Boolean @default(false)
  enabled       Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campId, enabled])
  @@index([campId, key])
}

// Typed columns for what's queryable/filterable; `tiers` is the one
// deliberate escape hatch for the tier ladder (no DSL) — e.g.
// [{maxMinutesLate:0,points:10},{maxMinutesLate:5,points:6},
//  {maxMinutesLate:10,points:3},{maxMinutesLate:null,points:0}]
model ScoreRule {
  id         String @id @default(cuid())
  camp       Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId     String
  categoryId String

  trigger   String // SCAN | SESSION | MEAL | MANUAL
  stationId String?
  subject   String // REGISTRATION | STAFF_PROFILE | TRIBE
  points    Int     @default(0)
  tiers     Json?

  // maxPerDay/maxPointsPerDay need DB state (today's count/sum for this
  // subject), so they're deliberately NOT evaluated in the pure rules.ts
  // evaluator — enforced atomically inside recordScoreEvent's transaction.
  multiplier      Float @default(1)
  maxPerDay       Int?
  maxPointsPerDay Int?
  minPoints       Int?
  maxPoints       Int?

  enabled       Boolean   @default(true)
  priority      Int       @default(0)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campId, enabled])
  @@index([campId, trigger, stationId])
}

// Deliberately NOT merged with AttendanceSession — that is a teacher-marked
// roster whose AttendanceRecord.recordedAt is "when the teacher pressed
// save", useless for punctuality. AttendanceSession.scoredSessionId is a
// one-way optional link the other direction.
model ScoredSession {
  id     String @id @default(cuid())
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String

  name         String
  date         DateTime  @db.Date
  startsAt     DateTime
  endsAt       DateTime?
  graceMinutes Int       @default(0)
  lateCutoff   DateTime?

  stationId   String?
  tribeId     String?
  campusId    String?
  scope       String  @default("CAMP") // CAMP | TRIBE | CAMPUS
  categoryId  String
  ruleId      String?
  // Point-station batches reuse ScoredSession so ScoreEvent.scoredSessionId
  // remains the single session link for attendance, scheduled scans, and
  // human-led QR awards. Null on legacy/scheduled sessions.
  awardPoints Int?
  // CAMPER | TEACHER | VOLUNTEER | ALL_STAFF. Null preserves legacy rows.
  subjectAudience String?
  createdById String?
  status      String  @default("SCHEDULED") // SCHEDULED | ACTIVE | CLOSED | CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campId, date])
  @@index([campId, status])
  @@index([createdById, status])
}

// The award carries a subjectKey ("T:<id>" / "C:<id>" / "S:<id>") rather
// than three separate nullable FK columns — a nullable-column composite
// unique would silently permit infinite duplicate awards across the null
// combinations.
model AchievementDefinition {
  id     String  @id @default(cuid())
  camp   Camp?   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String? // null = org-level template

  key         String
  name        String
  description String?
  icon        String?
  subjectType String // TRIBE | CAMPER | STAFF
  criteria    Json?
  points      Int?
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  awards AchievementAward[]

  @@index([campId, enabled])
}

model AchievementAward {
  id           String                @id @default(cuid())
  definition   AchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  definitionId String
  campId       String

  subjectKey String // "T:<tribeId>" | "C:<registrationId>" | "S:<staffProfileId>"

  awardedAt   DateTime @default(now())
  awardedById String?

  @@unique([definitionId, subjectKey])
  @@index([campId, awardedAt])
}

// The materialised read cache — leaderboard.overview reads only this table,
// never ScoreEvent directly. Write-through from recordScoreEvent's
// applyStatDelta, deliberately never invalidated; a nightly rebuildLeaderboard
// full recompute corrects any drift. Two partial unique indexes (WHERE "day"
// IS NULL for the TOTAL row / WHERE "day" IS NOT NULL for daily rows) are
// added via raw SQL in a follow-up migration — a plain composite unique can't
// express "one TOTAL row plus one row per day" since day is nullable.
model LeaderboardStat {
  id          String    @id @default(cuid())
  campId      String
  subjectType String // TRIBE | CAMPER | STAFF | CAMPUS
  subjectId   String
  day         DateTime? @db.Date // null = all-time TOTAL row

  totalPoints      Int      @default(0)
  rank             Int?
  rankDelta        Int?
  attendancePct    Float?
  promptnessPct    Float?
  currentStreak    Int      @default(0)
  achievementCount Int      @default(0)
  avgScoreToday    Float?
  campersPresent   Int?
  // STAFF: a 0-5 blend of attendancePct/promptnessPct/totalPoints/
  // achievementCount per LeaderboardSettings.teacherMetricWeights (min-max
  // normalized across the camp's teachers, then weighted). CAMPER: the same
  // blend on a 0-100 scale, used only as a sort key (see
  // LeaderboardSettings.camperMetricWeights) — never shown as a rating.
  // TRIBE/CAMPUS leave this null; nothing ranks them on anything but raw
  // totalPoints. Only ever set by computeDerivedStats (aggregate.ts),
  // same as the other derived-stat columns above.
  compositeScore   Float?
  computedAt       DateTime @default(now())

  @@index([campId, subjectType, day, totalPoints])
  @@index([campId, subjectType, subjectId, day])
}

model LeaderboardSettings {
  id     String @id @default(cuid())
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String @unique

  publicEnabled          Boolean   @default(false)
  // randomBytes(16).toString("hex") — the SignupLink precedent. Rotating
  // this permanently kills the old public URL; disabling keeps the token
  // but stops serving it. Missing/disabled -> NOT_FOUND, never FORBIDDEN.
  publicToken            String?   @unique
  refreshIntervalSeconds Int       @default(30)
  showTribes             Boolean   @default(true)
  showCampers            Boolean   @default(true)
  showTeachers           Boolean   @default(true)
  showCampuses           Boolean   @default(false)
  showAchievements       Boolean   @default(true)
  camperMetricWeights    Json?
  teacherMetricWeights   Json?
  campusMetricWeights    Json?
  // CHECKOUT | CAMP_END | MANUAL — how "camp completion" points get awarded
  // (aggregate.ts / dailyOps.ts). Deliberately a String, not an enum: a new
  // enum value would need its own migration ahead of any use of it (see
  // CLAUDE.md), and this set is small, camp-scoped config rather than a
  // referential type. Defaults to MANUAL so nothing fires until an admin
  // opts in.
  completionMode         String    @default("MANUAL")
  completionPoints       Int       @default(50)
  timezone               String    @default("Africa/Lagos")
  lastRebuildAt          DateTime?
  // O(1) reset: archive the settings row's cutoff instead of deleting
  // ScoreEvent history.
  archivedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExportJob {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  kind           String // CAMPERS | CAMPERS_MEDICAL | ID_CARDS | ATTENDANCE_SHEET | REGISTRATIONS | STAFF | REPORT_OPERATIONS | CONFIG_BUNDLE | TEMPLATE
  format         String // XLSX | CSV | JSON | MD | PDF
  label          String
  params         Json
  status         String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | CANCELLED
  stage          String?
  progress       Int       @default(0)
  processed      Int?
  total          Int?
  fileName       String?
  mimeType       String?
  fileSize       Int?
  fileData       Bytes?
  error          String?
  errorHint      String?
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([organizationId, userId, createdAt])
  @@index([expiresAt])
}

model SideEffect {
  id                   String         @id @default(cuid())
  registrationId       String?
  broadcastRecipientId String?
  campaignId           String?
  campaign             EmailCampaign? @relation(fields: [campaignId], references: [id])
  organizationId       String?
  deliverySource       String? // REGISTRATION_APPROVED | CAMPAIGN | OTP | WELCOME | STAFF_APPROVED | BROADCAST_SEND | ...
  recipientEmail       String? // for display in queue UI
  recipientType        String? // PARENT | TEACHER | VOLUNTEER | CAMPUS_REP | ADMIN
  txId                 String? // Resend/history log id for tracking
  type                 String // REGISTRATION_APPROVED | BROADCAST_SEND | CAMPAIGN_SEND | ...
  status               String         @default("QUEUED") // QUEUED | DONE | FAILED | CANCELLED
  attempts             Int            @default(0)
  lastError            String?
  runAfter             DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Additive: carries structured data for outbox consumers that don't fit the
  // existing string/id columns above — first user is the leaderboard's
  // SCORE_* effects (scanEventId, stationId, campId, etc).
  payload Json?

  @@index([status, runAfter])
  @@index([campaignId])
  @@index([organizationId, status])
  @@index([recipientEmail])
  // Additive: supports drainScoreQueue's `type: {startsWith:"SCORE_"}` filter
  // without a full scan of the QUEUED backlog.
  @@index([type, status, runAfter])
}

model RegistrationCounter {
  id       String @id @default(cuid())
  camp     Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId   String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  campusId String
  value    Int    @default(0)

  @@unique([campId, campusId])
}

// ─── Teacher & Volunteer (Staff) Modules ────────────────────────────────────

enum StaffType {
  TEACHER
  VOLUNTEER
}

enum StaffStatus {
  PENDING
  APPROVED
  REJECTED
  DEACTIVATED
}

model StaffSignupLink {
  id             String                 @id @default(cuid())
  token          String                 @unique
  type           StaffType
  camp           Camp                   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId         String
  organizationId String
  active         Boolean                @default(true)
  clicks         StaffSignupLinkClick[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([campId, type])
}

model StaffFieldValue {
  id             String       @id @default(cuid())
  value          String
  field          FormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId        String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  staffProfileId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fieldId, staffProfileId])
}

model StaffProfile {
  id             String      @id @default(cuid())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organizationId String
  camp           Camp        @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId         String
  type           StaffType
  status         StaffStatus @default(PENDING)

  // Personal
  firstName     String
  lastName      String
  preferredName String?
  gender        String?
  dateOfBirth   DateTime?
  phone         String
  email         String
  photoUrl      String?

  // Church
  church           String?
  churchDepartment String?
  yearsServing     String?
  workerStatus     String?

  // Camp preferences
  previousCampExperience String?
  areasOfStrength        String?
  preferredAgeGroup      String?
  preferredCampus        Campus? @relation("PreferredStaffCampus", fields: [preferredCampusId], references: [id])
  preferredCampusId      String?
  preferredTribe         Tribe?  @relation("PreferredTribe", fields: [preferredTribeId], references: [id])
  preferredTribeId       String?

  // Volunteer-specific
  volunteerCategory String?
  teams             String[]

  // Shared
  skills                       String[]
  availability                 String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  medicalConditions            String?
  allergies                    String?

  // Review
  submittedAt     DateTime  @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  reviewerId      String?
  deactivatedAt   DateTime?

  // Assignment (post-approval)
  assignedVenue      Venue?  @relation("AssignedStaffVenue", fields: [assignedVenueId], references: [id])
  assignedVenueId    String?
  assignedTribe      Tribe?  @relation("AssignedStaffTribe", fields: [assignedTribeId], references: [id])
  assignedTribeId    String?
  maleHeadOfTribes   Tribe[] @relation("TribeMaleHead")
  femaleHeadOfTribes Tribe[] @relation("TribeFemaleHead")

  // Camp Structure: department & position flags
  department            Department? @relation(fields: [departmentId], references: [id])
  departmentId          String?
  preferredDepartment   Department? @relation("PreferredStaffDepartment", fields: [preferredDepartmentId], references: [id], onDelete: SetNull)
  preferredDepartmentId String?
  isDepartmentHead      Boolean     @default(false)
  isAssistantHead       Boolean     @default(false)
  isCampMonitor         Boolean     @default(false)
  isAssistantMonitor    Boolean     @default(false)

  // Camp Structure: reporting hierarchy (exactly one of these two is set, enforced in the router)
  reportsTo       StaffProfile?  @relation("ReportsTo", fields: [reportsToId], references: [id])
  reportsToId     String?
  directReports   StaffProfile[] @relation("ReportsTo")
  reportsToUser   User?          @relation("StaffReportsToUser", fields: [reportsToUserId], references: [id])
  reportsToUserId String?

  // Camp Structure: teacher/volunteer accommodation assignment
  assignedHostel   Hostel? @relation("AssignedStaffHostel", fields: [assignedHostelId], references: [id])
  assignedHostelId String?
  assignedRoom     Room?   @relation("AssignedStaffRoom", fields: [assignedRoomId], references: [id])
  assignedRoomId   String?
  assignedBed      Bed?    @relation("AssignedStaffBed")

  fieldValues                 StaffFieldValue[]
  camperAssignments           TeacherCamperAssignment[]
  positionAssignments         PositionAssignment[]
  assignedChecklistItems      DepartmentChecklistItem[]      @relation("ChecklistItemAssignedStaff")
  assignedChecklistExecutions DepartmentChecklistExecution[] @relation("ChecklistExecutionAssignedStaff")

  // Camp ID card / scan identity — nullable, lazily issued on approval (see
  // ensureStaffQrToken). "STF-" prefixed so the scan resolver can distinguish
  // a staff badge from a camper Registration.qrToken without ambiguity.
  qrToken         String?          @unique
  qrIssuedAt      DateTime?
  staffScanEvents StaffScanEvent[]
  attendanceRecords StaffAttendanceRecord[]
  mealDistributions StaffMealDistribution[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Partial unique index (WHERE "deletedAt" IS NULL) — StaffProfile_userId_campId_key,
  // added by prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([userId, campId])
  @@index([organizationId, type, status])
  @@index([deletedAt])
  @@index([preferredDepartmentId])
}

// Staff (teacher/volunteer) badge scan log — deliberately parallel to
// ScanEvent rather than reusing it: ScanEvent.registrationId is a required
// FK, and relaxing that would touch 12+ existing camper-scan write sites and
// every report/reader. This table is purely additive.
model StaffScanEvent {
  id             String       @id @default(cuid())
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  staffProfileId String
  camp           Camp?        @relation(fields: [campId], references: [id])
  campId         String?
  station        String
  timestamp      DateTime     @default(now())
  scannedBy      User         @relation("StaffScanScannedBy", fields: [scannedById], references: [id], onDelete: Cascade)
  scannedById    String
  device         String?
  location       String?
  result         String // SUCCESS | DUPLICATE | ERROR
  metadata       Json?
  dedupeKey      String?      @unique

  @@index([staffProfileId])
  @@index([campId])
  @@index([timestamp])
}

model TeacherCamperAssignment {
  id             String       @id @default(cuid())
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  staffProfileId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String
  createdAt      DateTime     @default(now())

  @@unique([staffProfileId, registrationId])
}

model AttendanceSession {
  id                   String             @id @default(cuid())
  camp                 Camp               @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId               String
  venue                Venue?             @relation(fields: [venueId], references: [id])
  venueId              String?
  tribe                Tribe?             @relation(fields: [tribeId], references: [id])
  tribeId              String?
  // Scalar-only on purpose: Campus already has a large relation surface and
  // attendance only needs an indexed scope discriminator.
  campusId             String?
  name                 String
  date                 DateTime
  startsAt             DateTime?
  lateAfterMinutes     Int                @default(0)
  status               String             @default("OPEN") // DRAFT | OPEN | CLOSED | CANCELLED
  closedAt             DateTime?
  closedById           String?
  allowVolunteerAccess Boolean            @default(false)
  audience             String             @default("CAMPER") // CAMPER | TEACHER | VOLUNTEER | ALL_STAFF
  createdById          String
  records              AttendanceRecord[]
  staffRecords         StaffAttendanceRecord[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Additive: one-way optional link to the leaderboard's own scheduled-session
  // concept. AttendanceSession/AttendanceRecord.recordedAt is "when the
  // teacher pressed save" — useless for punctuality — so ScoredSession is a
  // deliberately separate model, not a merge. No back-relation to keep this
  // model untouched otherwise.
  scoredSessionId String?

  // Additive: this model previously had zero indexes.
  @@index([campId, date])
  @@index([tribeId, date])
  @@index([campusId, date])
  @@index([scoredSessionId])
  @@index([status, date])
}

model StaffAttendanceRecord {
  id             String            @id @default(cuid())
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  staffProfile   StaffProfile      @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  staffProfileId String
  status         String
  source         String            @default("MANUAL")
  markedAt       DateTime          @default(now())
  updatedById    String?
  notes          String?
  scoreVersion   Int               @default(0)
  scoreEventId   String?
  recordedById   String
  recordedAt     DateTime          @default(now())

  @@unique([sessionId, staffProfileId])
  @@index([staffProfileId])
  @@index([scoreEventId])
}

model AttendanceRecord {
  id             String            @id @default(cuid())
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  registration   Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String
  status         String // PRESENT | ABSENT | LATE
  source         String            @default("MANUAL") // QR | SEARCH | MANUAL | OFFLINE
  markedAt       DateTime          @default(now())
  updatedById    String?
  notes          String?
  scoreVersion   Int               @default(0)
  scoreEventId   String?
  recordedById   String
  recordedAt     DateTime          @default(now())

  @@unique([sessionId, registrationId])
  // Additive: the unique index above leads with sessionId, wrong column for
  // "all attendance records for this registration" lookups.
  @@index([registrationId])
  @@index([scoreEventId])
}

