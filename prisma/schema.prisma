// ─── Camp Structure & Organogram ────────────────────────────────────────────

model Department {
  id                                   String                         @id @default(cuid())
  organizationId                       String
  camp                                 Camp?                          @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId                               String? // per-camp instance, matching Tribe; null = org-wide template
  name                                 String
  systemKey                            String? // CAMP_COMMAND for the protected leadership department
  description                          String?
  purpose                              String?
  responsibilities                     String[]                       @default([])
  authority                            String[]                       @default([])
  successMeasures                      String[]                       @default([])
  workingRelationships                 String[]                       @default([])
  parentDepartmentId                   String?
  parentDepartment                     Department?                    @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments                     Department[]                   @relation("DepartmentHierarchy")
  displayOrder                         Int                            @default(0)
  allowMembersAddChecklistItems        Boolean                        @default(false)
  allowMembersEditChecklistItems       Boolean                        @default(false)
  allowMembersDeactivateChecklistItems Boolean                        @default(false)
  enableRoutineChecklists              Boolean                        @default(true)
  enableProgrammeTriggeredTasks        Boolean                        @default(false)
  enableDeadlineReminders              Boolean                        @default(true)
  status                               String                         @default("ACTIVE") // ACTIVE | INACTIVE
  maxCapacity                          Int? // null = unlimited; mirrors Tribe.maxCapacity
  positions                            Position[]
  announcements                        DepartmentAnnouncement[]
  documents                            DepartmentDocument[]
  activityLogs                         DepartmentActivityLog[]
  checklistItems                       DepartmentChecklistItem[]
  checklistExecutions                  DepartmentChecklistExecution[]
  reports                              DepartmentReport[]
  staff                                StaffProfile[]
  preferredByStaff                     StaffProfile[]                 @relation("PreferredStaffDepartment")
  deletedAt                            DateTime?
  createdAt                            DateTime                       @default(now())
  updatedAt                            DateTime                       @updatedAt

  // Partial unique index (WHERE "deletedAt" IS NULL) —
  // Department_organizationId_campId_name_key, added by
  // prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([organizationId, campId, name])
  @@index([campId, systemKey])
  @@index([parentDepartmentId, displayOrder])
  @@index([deletedAt])
}

model Hostel {
  id             String         @id @default(cuid())
  organizationId String
  venue          Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId        String
  name           String // e.g. "Male Hostel A"
  gender         String? // MALE | FEMALE | MIXED
  rooms          Room[]
  floors         HostelFloor[]
  staffAssigned  StaffProfile[] @relation("AssignedStaffHostel")
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Partial unique index (WHERE "deletedAt" IS NULL) — Hostel_venueId_name_key,
  // added by prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([venueId, name])
  @@index([deletedAt])
}

model HostelFloor {
  id              String    @id @default(cuid())
  hostel          Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId        String
  name            String
  code            String?
  level           Int       @default(0)
  roomNumberStart Int?
  displayOrder    Int       @default(0)
  rooms           Room[]
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([hostelId, displayOrder])
  @@index([deletedAt])
}

model Room {
  id            String         @id @default(cuid())
  hostel        Hostel         @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId      String
  floor         HostelFloor?   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  floorId       String?
  name          String // e.g. "Room 12"
  capacity      Int?
  roomType      RoomType       @default(STANDARD)
  locationLabel String?
  displayOrder  Int            @default(0)
  beds          Bed[]
  registrations Registration[]
  staffAssigned StaffProfile[] @relation("AssignedStaffRoom")
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Partial unique index (WHERE "deletedAt" IS NULL) — Room_hostelId_name_key,
  // added by prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([hostelId, name])
  @@index([floorId, displayOrder])
  @@index([deletedAt])
}

enum RoomType {
  STANDARD
  SPECIAL
  COMMON
}

model Bed {
  id             String        @id @default(cuid())
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId         String
  label          String // e.g. "Bed 1"
  status         BedStatus     @default(AVAILABLE)
  registration   Registration? @relation(fields: [registrationId], references: [id])
  registrationId String?       @unique
  // Exclusive alternative to registrationId — a bed holds one camper OR one
  // staff member at a time, enforced in the assignment mutations, not the DB.
  staffProfile   StaffProfile? @relation("AssignedStaffBed", fields: [staffProfileId], references: [id])
  staffProfileId String?       @unique
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Partial unique index (WHERE "deletedAt" IS NULL) — Bed_roomId_label_key,
  // added by prisma/migrations/20260728000000_partial_unique_indexes.
  @@index([roomId, label])
  @@index([deletedAt])
}

model TribePointsLog {
