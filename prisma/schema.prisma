model DepartmentChecklistExecution {
  id                   String                   @id @default(cuid())
  executionKey         String                   @unique
  checklistItem        DepartmentChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  checklistItemId      String?
  department           Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentId         String
  camp                 Camp                     @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId               String
  date                 DateTime                 @db.Date
  contextType          String?
  contextId            String?
  contextName          String?
  contextStartsAt      DateTime?
  taskTitle            String
  taskDescription      String?
  routine              ChecklistRoutine
  sourceGroup          String?
  assignmentType       ChecklistAssignmentType
  position             Position?                @relation(fields: [positionId], references: [id], onDelete: SetNull)
  positionId           String?
  roleNameSnapshot     String?
  assignedStaff        StaffProfile?            @relation("ChecklistExecutionAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedStaffId      String?
  assignedNameSnapshot String?
  dueAt                DateTime?
  required             Boolean                  @default(true)
  definitionVersion    Int                      @default(1)
  status               ChecklistExecutionStatus @default(PENDING)
  completedById        String?
  completedAt          DateTime?
  skippedById          String?
  skippedAt            DateTime?
  note                 String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([departmentId, date, status])
  @@index([campId, date, status])
  @@index([assignedStaffId, date, status])
  @@index([positionId, date, status])
  @@index([contextId])
}

model DepartmentReport {
  id              String     @id @default(cuid())
